<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <PackageId>NodalMerge.Host.Composition</PackageId>
    <Description>Compatibility wrapper package that forwards to ActiveSync.Host.Composition during migration.</Description>
    <PackageTags>nodalmerge;sync;crdt;host;composition;wrapper;compatibility</PackageTags>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\NUGET_README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActiveSync.Host.Composition\ActiveSync.Host.Composition.csproj" />
  </ItemGroup>

</Project>
