<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7575e404-45c6-42e8-9cba-3a37140683ce</UserSecretsId>
    <ActiveSyncUseNuGetPackages Condition="'$(ActiveSyncUseNuGetPackages)' == ''">false</ActiveSyncUseNuGetPackages>
    <ActiveSyncPackageVersion Condition="'$(ActiveSyncPackageVersion)' == ''">0.1.0-local</ActiveSyncPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(ActiveSyncUseNuGetPackages)' != 'true'">
    <ProjectReference Include="..\ActiveSync.Host.Abstractions\ActiveSync.Host.Abstractions.csproj" />
    <ProjectReference Include="..\ActiveSync.Host.Composition\ActiveSync.Host.Composition.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(ActiveSyncUseNuGetPackages)' == 'true'">
    <PackageReference Include="ActiveSync.Host.Abstractions" Version="$(ActiveSyncPackageVersion)" />
    <PackageReference Include="ActiveSync.Host.Composition" Version="$(ActiveSyncPackageVersion)" />
    <PackageReference Include="ActiveSync.DotNetHost.Native.win-x64" Version="$(ActiveSyncPackageVersion)" />
    <PackageReference Include="ActiveSync.DotNetHost.Native.linux-x64" Version="$(ActiveSyncPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="appsettings.json" />
    <Content Remove="appsettings.Development.json" />
    <None Remove="appsettings.json" />
    <None Remove="appsettings.Development.json" />

    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
