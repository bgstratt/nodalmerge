{
  "version": 2,
  "description": "Reusable authorization conformance vectors for Rust host and DotNetHost (includes supplemental capability-composition vectors)",
  "vectors": [
    {
      "id": "AUTHN-UNLOCKED-HELLO-001",
      "category": "authn",
      "scenario": "unlocked room accepts hello without token",
      "input": {
        "room_locked": false,
        "hello": {
          "has_token": false
        }
      },
      "expected": {
        "result": "allow"
      }
    },
    {
      "id": "AUTHN-LOCKED-HELLO-001",
      "category": "authn",
      "scenario": "locked room rejects missing token",
      "input": {
        "room_locked": true,
        "hello": {
          "has_token": false
        }
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.auth_violation"
      }
    },
    {
      "id": "AUTHZ-CONTROL-SETPOLICY-001",
      "category": "authz",
      "scenario": "set-policy denied without policy.admin",
      "input": {
        "command": "set-policy",
        "capabilities": ["read:**"]
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.control_plane_forbidden",
        "command": "set-policy",
        "required_capability": "policy.admin"
      }
    },
    {
      "id": "AUTHZ-CONTROL-SETPOLICY-002",
      "category": "authz",
      "scenario": "set-policy allowed with policy.admin",
      "input": {
        "command": "set-policy",
        "capabilities": ["policy.admin"]
      },
      "expected": {
        "result": "allow"
      }
    },
    {
      "id": "AUTHZ-CONTROL-SETROOMKEY-001",
      "category": "authz",
      "scenario": "set-room-key denied without room.admin",
      "input": {
        "command": "set-room-key",
        "capabilities": ["read:**"]
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.control_plane_forbidden",
        "command": "set-room-key",
        "required_capability": "room.admin"
      }
    },
    {
      "id": "AUTHZ-CONTROL-TICK-001",
      "category": "authz",
      "scenario": "start-tick denied without tick.admin",
      "input": {
        "command": "start-tick",
        "capabilities": ["read:**"]
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.control_plane_forbidden",
        "command": "start-tick",
        "required_capability": "tick.admin"
      }
    },
    {
      "id": "REPLAY-TIMELINE-001",
      "category": "replay",
      "scenario": "policy cutover at lamport boundary is inclusive",
      "input": {
        "timeline": [
          { "effective_lamport": 2, "policy_tag": "tightened" }
        ],
        "operations": [
          { "lamport": 1, "author": "B", "path": "protected/x", "kind": "set" },
          { "lamport": 2, "author": "B", "path": "protected/x", "kind": "set" }
        ]
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.policy_violation"
      }
    },
    {
      "id": "DENY-PARITY-001",
      "category": "deny",
      "scenario": "deny metadata includes concrete command and required capability when available",
      "input": {
        "command": "set-policy",
        "capabilities": ["read:**"],
        "ingress_paths": ["runtime", "ffi"]
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.control_plane_forbidden",
        "command": "set-policy",
        "required_capability": "policy.admin"
      }
    },
    {
      "id": "POLICY-CHANNEL-ADMIN-001",
      "category": "policy-channel",
      "scenario": "admin_command_only mode allows admin command policy updates",
      "input": {
        "policy_channel_mode": "admin_command_only",
        "policy_source": "admin_command"
      },
      "expected": {
        "result": "allow",
        "command": "set-policy",
        "required_capability": "policy.admin"
      }
    },
    {
      "id": "POLICY-CHANNEL-ADMIN-002",
      "category": "policy-channel",
      "scenario": "admin_command_only mode denies replicated signed policy updates",
      "input": {
        "policy_channel_mode": "admin_command_only",
        "policy_source": "replicated_signed_op"
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.control_plane_forbidden",
        "command": "set-policy",
        "required_capability": "policy.admin"
      }
    },
    {
      "id": "POLICY-CHANNEL-HYBRID-001",
      "category": "policy-channel",
      "scenario": "hybrid mode allows replicated signed policy updates",
      "input": {
        "policy_channel_mode": "hybrid",
        "policy_source": "replicated_signed_op"
      },
      "expected": {
        "result": "allow",
        "command": "set-policy",
        "required_capability": "policy.admin"
      }
    },
    {
      "id": "POLICY-CHANNEL-REPLICATED-001",
      "category": "policy-channel",
      "scenario": "replicated_signed_ops_only mode denies admin command policy updates",
      "input": {
        "policy_channel_mode": "replicated_signed_ops_only",
        "policy_source": "admin_command"
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.control_plane_forbidden",
        "command": "set-policy",
        "required_capability": "policy.admin"
      }
    },
    {
      "id": "IDENTITY-NORMALIZATION-001",
      "category": "identity",
      "scenario": "actor/signer normalization treats case and surrounding whitespace as equivalent",
      "input": {
        "actor_id": " Peer-A ",
        "signer_id": "peer-a",
        "require_actor_signer_match": true
      },
      "expected": {
        "result": "allow",
        "command": "identity-normalization"
      }
    },
    {
      "id": "IDENTITY-NORMALIZATION-002",
      "category": "identity",
      "scenario": "actor/signer normalization rejects mismatch when signer differs",
      "input": {
        "actor_id": "peer-a",
        "signer_id": "peer-b",
        "require_actor_signer_match": true
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.auth_violation",
        "command": "identity-normalization"
      }
    },
    {
      "id": "IDENTITY-CONTINUITY-001",
      "category": "identity",
      "scenario": "continuity proof allows successor signer during configured overlap window",
      "input": {
        "identity_action": "continuity_proof",
        "actor_id": "peer-a",
        "signer_id": "peer-b",
        "predecessor_signer_id": "peer-a",
        "now_epoch_secs": 100,
        "overlap_not_after_epoch_secs": 120,
        "revoked_predecessors": []
      },
      "expected": {
        "result": "allow",
        "command": "identity-continuity"
      }
    },
    {
      "id": "IDENTITY-CONTINUITY-002",
      "category": "identity",
      "scenario": "continuity proof rejects successor signer after overlap window expiry",
      "input": {
        "identity_action": "continuity_proof",
        "actor_id": "peer-a",
        "signer_id": "peer-b",
        "predecessor_signer_id": "peer-a",
        "now_epoch_secs": 121,
        "overlap_not_after_epoch_secs": 120,
        "revoked_predecessors": []
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.auth_violation",
        "reason_detail": "overlap_window_expired",
        "command": "identity-continuity"
      }
    },
    {
      "id": "IDENTITY-CONTINUITY-003",
      "category": "identity",
      "scenario": "continuity proof rejects successor signer when predecessor key is revoked",
      "input": {
        "identity_action": "continuity_proof",
        "actor_id": "peer-a",
        "signer_id": "peer-b",
        "predecessor_signer_id": "peer-a",
        "now_epoch_secs": 100,
        "overlap_not_after_epoch_secs": 120,
        "revoked_predecessors": ["peer-a"]
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.auth_violation",
        "reason_detail": "revoked_predecessor_key",
        "command": "identity-continuity"
      }
    },
    {
      "id": "SCOPE-SUBSCRIBE-COMMAND-001",
      "category": "scope",
      "scenario": "subscription scope command maps normalized patterns after hello",
      "input": {
        "scope_action": "subscribe_command",
        "patterns": ["world/**", "chat/*"]
      },
      "expected": {
        "result": "allow",
        "command": "subscribe"
      }
    },
    {
      "id": "SCOPE-SUBSCRIBE-ACK-001",
      "category": "scope",
      "scenario": "subscription update host event maps to subscribe-ack runtime message",
      "input": {
        "scope_action": "subscription_updated_event",
        "patterns": ["world/**"]
      },
      "expected": {
        "result": "allow",
        "command": "subscribe-ack"
      }
    },
    {
      "id": "SCOPE-FILTER-MATCH-001",
      "category": "scope",
      "scenario": "subscription scope filtering keeps nodes that match configured path patterns",
      "input": {
        "scope_action": "filter_pack_paths",
        "patterns": ["world/**"],
        "node_paths": ["world/doc-1", "chat/general"]
      },
      "expected": {
        "result": "allow",
        "command": "scope-filter"
      }
    },
    {
      "id": "SCOPE-FILTER-REJECT-001",
      "category": "scope",
      "scenario": "subscription scope filtering drops nodes when none match configured path patterns",
      "input": {
        "scope_action": "filter_pack_paths",
        "patterns": ["world/**"],
        "node_paths": ["chat/general", "presence/peer-a"]
      },
      "expected": {
        "result": "deny",
        "reason_class": "reject.protocol_violation",
        "command": "scope-filter"
      }
    },
    {
      "id": "CAPCOMP-EXPAND-ALLOW-001",
      "category": "capcomp",
      "scenario": "supplemental: host expands additive DAG and emits deterministic flattened set",
      "input": {
        "profile_test_scope": "supplemental",
        "capability_profile_version": "capprof-v1",
        "assigned_capabilities": ["room.admin", " POLICY.ADMIN "],
        "profile": {
          "profile_version": "capprof-v1",
          "nodes": [
            { "capability": "room.admin", "inherits": ["tick.admin"] },
            { "capability": "tick.admin", "inherits": [] },
            { "capability": "policy.admin", "inherits": [] }
          ]
        }
      },
      "expected": {
        "result": "allow",
        "command": "capability-composition",
        "capability_profile_version": "capprof-v1",
        "expanded_capabilities": ["policy.admin", "room.admin", "tick.admin"]
      }
    },
    {
      "id": "CAPCOMP-EXPAND-ALLOW-002",
      "category": "capcomp",
      "scenario": "supplemental: multi-path inheritance deduplicates to a canonical flattened set",
      "input": {
        "profile_test_scope": "supplemental",
        "capability_profile_version": "capprof-v1",
        "assigned_capabilities": ["compose.root"],
        "profile": {
          "profile_version": "capprof-v1",
          "nodes": [
            { "capability": "compose.root", "inherits": ["compose.a", "compose.b"] },
            { "capability": "compose.a", "inherits": ["compose.shared"] },
            { "capability": "compose.b", "inherits": ["compose.shared"] },
            { "capability": "compose.shared", "inherits": [] }
          ]
        }
      },
      "expected": {
        "result": "allow",
        "command": "capability-composition",
        "capability_profile_version": "capprof-v1",
        "expanded_capabilities": ["compose.a", "compose.b", "compose.root", "compose.shared"]
      }
    },
    {
      "id": "CAPCOMP-COMPAT-ALLOW-001",
      "category": "capcomp",
      "scenario": "supplemental: compatibility window accepts explicitly supported prior profile version",
      "input": {
        "profile_test_scope": "supplemental",
        "capability_profile_version": "capprof-v2",
        "assigned_capabilities": ["policy.admin"],
        "profile": {
          "profile_version": "capprof-v3",
          "supported_profile_versions": ["capprof-v2"],
          "nodes": [
            { "capability": "policy.admin", "inherits": [] }
          ]
        }
      },
      "expected": {
        "result": "allow",
        "command": "capability-composition",
        "capability_profile_version": "capprof-v3",
        "expanded_capabilities": ["policy.admin"]
      }
    },
