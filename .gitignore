# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# .NET / Visual Studio build artifacts
**/bin/
**/obj/
**/TestResults/

# ...but not Rust's `src/bin/` convention for multiple binaries (e.g.
# server/src/bin/authz_conformance_runner.rs) — .NET bin/ dirs are always
# named after their project folder, never literally "src/bin".
!**/src/bin/
!**/src/bin/**

# Test dumps and diagnostics
*.dmp
*.coverage
*.trx

# Local IDE metadata
.vs/

# Local runtime persistence artifacts
data/*.db
data/*.db-shm
data/*.db-wal

# Build/publish artifacts
artifacts/
BenchmarkDotNet.Artifacts/
dotnet-host/artifacts/

# Generated at pack time from web/sdk.js by sdk-js/scripts/gen-doc-module.mjs
sdk-js/doc.js
sdk-js/doc.d.ts

# Local npm pack artifacts (generated tarballs)
**/*.tgz
bridge/pkg/*.tgz
sdk-js/*.tgz
wrappers/**/*.tgz
artifacts/package-local/npm/*.tgz

# Local test execution logs
.tmp-testlogs/
