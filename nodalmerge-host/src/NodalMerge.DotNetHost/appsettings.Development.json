{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "NodalMerge.RuntimeWs": "Information",
      "NodalMerge.DotNetHost.Runtime": "Information"
    }
  },
  "NodalMerge": {
    "Providers": {
      "NodeStorage": "InMemory",
      "BlobStorage": "WsOnly",
      "Auth": "JwtBridgeEmbedded"
    },
    "Storage": {
      "Sqlite": {
        "DbPath": "data/nodalmerge-nodes.db"
      },
      "FileBlobs": {
        "RootPath": "data/blobs"
      },
      "Mongo": {
        "ConnectionString": "mongodb://localhost:27017",
        "DatabaseName": "nodalmerge"
      },
      "S3Delegated": {
        "BaseUrl": "https://example-delegate.local",
        "TimeoutSeconds": 5,
        "PutPath": "/v1/blobs/presign-put",
        "GetPath": "/v1/blobs/presign-get"
      }
    },
    "Auth": {
      "JwtBridgeEmbedded": {
        "Issuer": "nodalmerge-host-dev",
        "Audience": "nodalmerge-clients-dev",
        "SigningKey": "dev-signing-key-change-me-1234567890"
      }
    },
    "Runtime": {
      "ServerPeerPubkeyHex": "",
      "PeerLocal": {
        "Enabled": false,
        "Backend": "embedded",
        "DataDir": "data/peer-local"
      },
      "Dag": {
        "Compaction": {
          "Enabled": true,
          "MinEligibleNodes": 8,
          "EnablePruning": true
        }
      }
    }
  }
}
