{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ActiveSync.RuntimeWs": "Information",
      "ActiveSync.DotNetHost.Runtime": "Information"
    }
  },
  "ActiveSync": {
    "Providers": {
      "NodeStorage": "Mongo",
      "BlobStorage": "S3Delegated",
      "Auth": "JwtBridgeSidecar"
    },
    "Storage": {
      "Mongo": {
        "ConnectionString": "mongodb://localhost:27017",
        "DatabaseName": "speechslate_activesync"
      },
      "S3Delegated": {
        "BaseUrl": "https://api.speechslate.example",
        "PutPath": "/v1/blobs/presign-put",
        "GetPath": "/v1/blobs/presign-get",
        "TimeoutSeconds": 5,
        "ApiKeyHeader": "X-Api-Key",
        "ApiKey": "replace-me",
        "MaxRetries": 2,
        "CircuitBreakerFailureThreshold": 3,
        "CircuitBreakerOpenSeconds": 30
      }
    },
    "Auth": {
      "JwtBridgeSidecar": {
        "BaseUrl": "https://api.speechslate.example/sync/token",
        "TimeoutSeconds": 5,
        "ApiKeyHeader": "X-Api-Key",
        "ApiKey": "replace-me"
      }
    },
    "Runtime": {
      "Dag": {
        "Compaction": {
          "Enabled": true,
          "MinEligibleNodes": 8,
          "EnablePruning": true
        }
      }
    }
  }
}
