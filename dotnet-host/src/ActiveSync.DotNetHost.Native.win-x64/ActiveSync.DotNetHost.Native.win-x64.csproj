<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageId>ActiveSync.DotNetHost.Native.win-x64</PackageId>
    <Description>Native host FFI runtime for ActiveSync .NET host on win-x64.</Description>
    <PackageTags>activesync;sync;crdt;native;ffi;windows</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\target\release\activesync_host_ffi.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/"
          Visible="false" />
  </ItemGroup>

</Project>
