{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://activesync.local/schemas/benchmark-matrix-result.v1.json",
  "title": "Benchmark Matrix Result v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_utc",
    "matrix_path",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "benchmark-matrix-result.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_utc": {
      "type": "string",
      "format": "date-time"
    },
    "matrix_path": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "status",
          "started_utc",
          "completed_utc"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": true
          },
          "scenario_result_path": {
            "type": "string"
          },
          "started_utc": {
            "type": "string",
            "format": "date-time"
          },
          "completed_utc": {
            "type": "string",
            "format": "date-time"
          },
          "aggregates": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "map_avg_ms": { "type": ["number", "null"] },
                "map_p95_ms": { "type": ["number", "null"] },
                "list_avg_ms": { "type": ["number", "null"] },
                "list_p95_ms": { "type": ["number", "null"] },
                "blob_avg_ms": { "type": ["number", "null"] },
                "blob_p95_ms": { "type": ["number", "null"] }
              },
              "additionalProperties": false
            }
          },
          "gate": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "baseline",
                  "pass",
                  "fail"
                ]
              },
              "comparisons": {
                "type": "object",
                "additionalProperties": true
              },
              "violations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": true
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}