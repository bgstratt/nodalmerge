            "max_dag_depth": 16,
            "max_edges_per_node": 64
          },
          "nodes": [
            { "capability": "compose.root", "inherits": ["compose.a", "compose.b"] },
            { "capability": "compose.a", "inherits": [] },
            { "capability": "compose.b", "inherits": [] }
          ]
        }
